rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsBatch() {
      return signedIn() && request.auth.uid == resource.data.ownerId;
    }

    function willOwnBatch() {
      return signedIn() && request.auth.uid == request.resource.data.ownerId;
    }

    match /users/{userId} {
      allow create: if ownsUserDocument(userId);
      allow read, update: if ownsUserDocument(userId);
      allow delete: if false;
    }

    match /batches/{batchId} {
      allow create: if willOwnBatch();
      allow read, update: if ownsBatch();
      allow delete: if false;
    }

    match /public_traces/{batchId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }
  }
}
